//@version=6
// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  GEX Levels — gexdash.com source                                             ║
// ║                                                                              ║
// ║  Plots dealer gamma exposure levels for SPX / NDX / QQQ / SPY / IWM from the  ║
// ║  gexdash.com public API (Schwab option-chain data). One string, pasted into  ║
// ║  the GEX Data field, carries four expiry buckets at once: 0DTE / Weekly /   ║
// ║  Monthly / All. Generate it with the companion CLI:                          ║
// ║      python3 -m gextv.cli QQQ        # prints + copies the string             ║
// ║                                                                              ║
// ║  Wire format (produced by gextv/emit.py):                                     ║
// ║    M:key=value,key=value|L:price,label,kind;price,label,kind;...             ║
// ║                                                                              ║
// ║  Metadata keys in the M: header:                                             ║
// ║    sym spot state basis asof src ng iv [rv oipc pcr ng0 ngw ngm nga]         ║
// ║                                                                              ║
// ║  Level kinds are <base><expiry-suffix>:                                       ║
// ║    res/sup     call wall / put wall        res0 resw resm res                 ║
// ║    flip        gamma flip                  flip0 flipw flipm flip            ║
// ║    gwall       gamma wall                  gwall0 gwallw gwallm gwall        ║
// ║    vtrig       vol trigger                                                        ║
// ║    hgex        dominant absolute-gamma strike                                     ║
// ║    gpos/gneg   most +/- net-GEX strike                                            ║
// ║    mpain       max pain (computed from OI by the CLI)                             ║
// ║    oic/oip/oimax  largest call-OI / put-OI / total-OI strike                     ║
// ║    emh/eml     expected-move band from spot                                    ║
// ║    ivh/ivl     1-day implied range from ATM IV                                 ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
indicator("GEX Levels — gexdash", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ──────────────────────────────── INPUTS ────────────────────────────────
const string TIP = "Paste the string from `python3 -m gextv.cli <SYMBOL>`. Format: M:key=value|L:price,label,kind;..."
const string IND_VER = "v10"
string srcText = input.text_area("", "GEX data string", group = "GEX Data", tooltip = TIP)
string basisMode = input.string("自动（按现价识别）", "价位换算", group = "GEX Data", options =
     ["自动（按现价识别）", "手动（倍数+价差）", "关闭（原价）"], tooltip =
     "换算公式：图表价位 = 数据价位 × 倍数 + 价差 —— 与参考脚本 f_convertPrice(S:价差/R:倍率) 同一套。\n"
     + "自动：按 图表现价÷数据spot 的比值定倍数，价差 = 现价 − 倍数×spot。同品种图≈原价。\n"
     + "手动：自己填倍数和价差。例：NDX串→NQ图 填 1 和 (NQ−NDX) 差值；NDX串→MNQ图 填 0.1。\n"
     + "关闭：显示数据原始价位。")
float manualMult   = input.float(1.0, "手动倍数", minval = 0.0001, step = 0.005, group = "GEX Data")
float manualSpread = input.float(0.0, "手动价差（换算后加上）", step = 0.25, group = "GEX Data")

// Expiry bucket visibility — each bucket is one line style.
bool sh0   = input.bool(true,  "0DTE",   group = "Expiry buckets", inline = "e")
bool shW   = input.bool(true,  "Weekly", group = "Expiry buckets", inline = "e")
bool shM   = input.bool(true,  "Monthly", group = "Expiry buckets", inline = "e")
bool shAll = input.bool(true,  "All-expiry", group = "Expiry buckets", inline = "e")

// Independent levels (max pain, OI walls, EM/IV bands).
bool shMpain = input.bool(true,  "Max pain", group = "Independent levels", inline = "i1")
bool shOI    = input.bool(true,  "OI walls (call/put/max)", group = "Independent levels", inline = "i1")
bool shEM    = input.bool(true,  "Expected move", group = "Independent levels", inline = "i2")
bool shIV    = input.bool(true,  "IV 1-day range", group = "Independent levels", inline = "i2")

// Style
int    lineWidth  = input.int(1, "Line width", minval = 1, maxval = 4, group = "Style")
int    labelOff   = input.int(8, "Label offset (bars)", minval = 0, maxval = 200, group = "Style")
bool   showPrice  = input.bool(true, "Show price in label", group = "Style")
string labelSize  = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal"], group = "Style")
string labelSide   = input.string("自动错开", "标签位置", options = ["自动错开", "线上方", "线下方", "线上居中"], group = "Style", tooltip =
     "自动错开：所有标签先按价位排序，相邻两个价格差小于阈值时一上一下交替放置，避免文字重叠。\n"
     + "线上方/线下方：全部标签统一放线上方/下方。\n"
     + "线上居中：标签气泡中线对齐价位（旧默认样式）。")
float  labelGapPct = input.float(0.05, "自动错开：相邻间距阈值（价格%）", minval = 0.001, maxval = 5.0, step = 0.01, group = "Style", tooltip = "相邻标签价格差小于当前价的此百分比时视为重叠，上下交替错开。数值越大越早错开。")
bool   showDebug  = input.bool(true,  "调试行（排查显示用）", group = "Style")

// Expiry bucket line styles (0DTE solid, Weekly dashed, Monthly dotted, All thick)
string s0 = input.string("Solid",   "0DTE style",   options = ["Solid", "Dashed", "Dotted"], group = "Bucket styles", inline = "bs0")
int    w0 = input.int(2,           "0DTE width",   minval = 1, maxval = 4, group = "Bucket styles", inline = "bs0")
string sW = input.string("Dashed",  "Weekly style", options = ["Solid", "Dashed", "Dotted"], group = "Bucket styles", inline = "bs1")
int    wW = input.int(1,           "Weekly width", minval = 1, maxval = 4, group = "Bucket styles", inline = "bs1")
string sM = input.string("Dotted",  "Monthly style", options = ["Solid", "Dashed", "Dotted"], group = "Bucket styles", inline = "bs2")
int    wM = input.int(1,           "Monthly width", minval = 1, maxval = 4, group = "Bucket styles", inline = "bs2")
string sA = input.string("Solid",   "All-expiry style", options = ["Solid", "Dashed", "Dotted"], group = "Bucket styles", inline = "bs3")
int    wA = input.int(3,           "All-expiry width", minval = 1, maxval = 4, group = "Bucket styles", inline = "bs3")

// Legend / abbreviation panel
bool   showPanel = input.bool(true, "Show legend panel", group = "Legend panel")
string panelPos = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = "Legend panel")
string panelSize = input.string("Tiny", "Panel text size", options = ["Tiny", "Small", "Normal"], group = "Legend panel")

// Colors
color cCall   = input.color(#26A69A, "Call wall",  group = "Colors", inline = "c1")
color cPut    = input.color(#EF5350, "Put wall",   group = "Colors", inline = "c1")
color cFlip   = input.color(#F0B90B, "Gamma flip", group = "Colors", inline = "c2")
color cGWall  = input.color(#F0B90B, "Gamma wall", group = "Colors", inline = "c2")
color cVTrig  = input.color(#9C27B0, "Vol trigger", group = "Colors", inline = "c3")
color cHGEX   = input.color(#FF9800, "HGEX",       group = "Colors", inline = "c3")
color cGpos   = input.color(#26A69A, "G+ (pos)",   group = "Colors", inline = "c4")
color cGneg   = input.color(#EF5350, "G- (neg)",   group = "Colors", inline = "c4")
color cMpain  = input.color(#F0B90B, "Max pain",   group = "Colors", inline = "c5")
color cOI     = input.color(#787B86, "OI walls",    group = "Colors", inline = "c5")
color cEM     = input.color(#3B82F6, "Expected move", group = "Colors", inline = "c6")
color cIV     = input.color(#7A7A85, "IV range",    group = "Colors", inline = "c6")

// ──────────────────────────────── HELPERS ────────────────────────────────
f_lineStyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : size.normal

// Strip the expiry suffix off a kind. Base kinds never end in 0/w/m, so the
// last character alone discriminates suffix vs. base. "all" bucket has no
// suffix.
f_baseKind(string k) =>
    int n = str.length(k)
    string last = n > 0 ? str.substring(k, n - 1, n) : ""
    (last == "0" or last == "w" or last == "m") ? str.substring(k, 0, n - 1) : k

f_bucketOf(string k) =>
    int n = str.length(k)
    string last = n > 0 ? str.substring(k, n - 1, n) : ""
    last == "0" ? "0dte" : last == "w" ? "weekly" : last == "m" ? "monthly" : "all"

// Map a kind to its color (independent of bucket).
f_color(string base) =>
    base == "res"   ? cCall
     : base == "sup"  ? cPut
     : base == "flip" ? cFlip
     : base == "gwall" ? cGWall
     : base == "vtrig" ? cVTrig
     : base == "hgex" ? cHGEX
     : base == "gpos" ? cGpos
     : base == "gneg" ? cGneg
     : base == "mpain" ? cMpain
     : base == "oic" or base == "oip" or base == "oimax" ? cOI
     : base == "emh" or base == "eml" ? cEM
     : base == "ivh" or base == "ivl" ? cIV
     : color.new(#7A7A85, 30)

f_bucketStyle(string bucket) =>
    // Returns [line_style:int, width:int]. Callers unpack with bare brackets:
    //   [st, wid] = f_bucketStyle(bucket)
    // (Pine v6: tuple unpacking takes no type prefix inside the brackets.)
    if bucket == "0dte"
        [f_lineStyle(s0), w0]
    else if bucket == "weekly"
        [f_lineStyle(sW), wW]
    else if bucket == "monthly"
        [f_lineStyle(sM), wM]
    else
        [f_lineStyle(sA), wA]

// Is a kind visible given the current settings?
f_visible(string base, string bucket) =>
    bool bucketOn = bucket == "0dte" ? sh0 : bucket == "weekly" ? shW : bucket == "monthly" ? shM : shAll
    if not bucketOn
        false
    else if base == "res" or base == "sup" or base == "flip" or base == "gwall" or base == "vtrig" or base == "hgex" or base == "gpos" or base == "gneg"
        true
    else if base == "mpain"
        shMpain
    else if base == "oic" or base == "oip" or base == "oimax"
        shOI
    else if base == "emh" or base == "eml"
        shEM
    else if base == "ivh" or base == "ivl"
        shIV
    else
        false

// ──────────────────────────── METADATA PARSER ────────────────────────────
// The M: header is M:k=v,k=v|... . Parse once on the first bar; values are
// surfaced in the legend panel and used to label the snapshot as live vs stale.
var string gSym     = ""
var string gSpot    = ""
var float  gSpotF   = na  // numeric data-source spot, for the conversion
var float  gConv    = 1.0 // multiplier: 1 index↔full futures, 0.1 micro/SPY, 0.025 QQQ≈NDX
var float  gShift   = 0.0 // additive offset: chart price − gConv × data spot
var string gState   = ""
var string gBasis   = ""
var string gAsof    = ""
var string gSrc     = ""
var string gNetGex  = ""
var string gIV      = ""
var string gRV      = ""
var string gOiPc    = ""

// The M: header is parsed inline in the main scope below, not in a function:
// Pine v6 (CE10088) forbids mutating var globals from inside a function, and
// every parsed field writes to one of the g* globals above.


// ───────────────────────────── DRAW STATE ───────────────────────────────
var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()
var label headerLabel = na
// Debug counters for the on-chart troubleshooting row.
var int dbgRows  = 0
var int dbgDrawn = 0

// ─────────────────────────────── PARSE + DRAW ───────────────────────────
if barstate.islast and str.length(srcText) > 0
    // Clear previous render.
    for l in lns
        line.delete(l)
    array.clear(lns)
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if not na(headerLabel)
        label.delete(headerLabel)
        headerLabel := na

    // Split header (M:...) from levels (L:...). Everything before "|L:" is the
    // header, everything after is the level list.
    string header = ""
    string levelStr = ""
    if str.contains(srcText, "|L:")
        int pipe = str.pos(srcText, "|L:")
        header := str.substring(srcText, 0, pipe)
        levelStr := str.substring(srcText, pipe + 3)
    else
        levelStr := srcText

    // Parse the M: header inline (CE10088: var globals cannot be written from
    // a function, so this cannot live in a helper). Same key=value split.
    string h = str.startswith(header, "M:") ? str.substring(header, 2) : header
    array<string> pairs = str.split(h, ",")
    for pair in pairs
        array<string> kv = str.split(pair, "=")
        if array.size(kv) == 2
            string key = array.get(kv, 0)
            string val = array.get(kv, 1)
            if key == "sym"
                gSym := val
            else if key == "spot"
                gSpot := val
                gSpotF := str.tonumber(val)
            else if key == "state"
                gState := val
            else if key == "basis"
                gBasis := val
            else if key == "asof"
                gAsof := val
            else if key == "src"
                gSrc := val
            else if key == "ng"
                gNetGex := val
            else if key == "iv"
                gIV := val
            else if key == "rv"
                gRV := val
            else if key == "oipc"
                gOiPc := val

    // Price-space conversion so pasted levels land on THIS chart's vertical
    // axis: chart_price = data_price × gConv + gShift — the same model as the
    // reference scripts' f_convertPrice (S: spread / R: ratio), generalized.
    // 自动 snaps gConv from close ÷ spot ratio bands and pins the snapshot
    // spot onto the live chart price; 手动 takes the user's multiplier and
    // spread verbatim; 关闭 renders raw data prices. Globals so the debug row
    // (a separate top-level block) can read them.
    bool canConvert = not na(gSpotF) and gSpotF > 0
    if not canConvert or basisMode == "关闭（原价）"
        gConv := 1.0
        gShift := 0.0
    else if basisMode == "手动（倍数+价差）"
        gConv := manualMult
        gShift := manualSpread
    else
        float ratio = close / gSpotF
        gConv := ratio >= 9.0 and ratio <= 11.0 ? 10.0 : ratio >= 0.09 and ratio <= 0.11 ? 0.1 : ratio >= 0.022 and ratio <= 0.028 ? 0.025 : 1.0
        gShift := close - gConv * gSpotF

    // One small label under the last bar summarising the snapshot — tells the
    // eye immediately whether the chart is live or carried-forward.
    string stamp = gSym + (gSym == "" ? "" : "  ") + gNetGex + (gIV == "" ? "" : "  IV " + gIV) + (gRV == "" ? "" : "  RV " + gRV) + (math.abs(gShift) > syminfo.mintick ? "  基差" + (gShift > 0 ? "+" : "") + str.tostring(gShift, "#.#") : "")
    if stamp != ""
        headerLabel := label.new(bar_index + labelOff, low - ta.tr, stamp, style = label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(#787B86, 0), size = size.tiny)

    // Parse "price,label,kind;price,label,kind;..."
    // Two passes: lines draw immediately; labels are collected, sorted by
    // price, then placed above/below so near-adjacent levels don't stack into
    // unreadable mush.
    dbgRows := 0
    dbgDrawn := 0
    if levelStr != ""
        array<string> rows = str.split(levelStr, ";")
        dbgRows := array.size(rows)
        float[]  lblY   = array.new_float()
        string[] lblTxt = array.new_string()
        color[]  lblCol = array.new_color()
        for row in rows
            array<string> f = str.split(row, ",")
            if array.size(f) == 3
                float p = str.tonumber(array.get(f, 0))
                string lbl = array.get(f, 1)
                string kind = array.get(f, 2)
                if not na(p) and p > 0
                    float y = p * gConv + gShift  // this chart's price space
                    string base = f_baseKind(kind)
                    string bucket = f_bucketOf(kind)
                    if f_visible(base, bucket)
                        color c = f_color(base)
                        // f_bucketStyle returns [style:int, width:int]. Per the
                        // Pine v6 docs, tuple unpacking is bare brackets with no
                        // type prefix: [a, b] = func(). Element types are inferred
                        // from the function's declared return.
                        [st, wid] = f_bucketStyle(bucket)
                        // The "All" bucket renders a touch wider and is drawn
                        // first so the per-expiry lines sit on top of it.
                        int useW = bucket == "all" ? math.max(wid, 2) : wid
                        array.push(lns, line.new(bar_index - 1, y, bar_index, y, extend = extend.both, color = c, width = useW, style = st))
                        dbgDrawn += 1
                        string txt = showPrice ? lbl + "  " + str.tostring(y, format.mintick) : lbl
                        array.push(lblY, y)
                        array.push(lblTxt, txt)
                        array.push(lblCol, c)

        // ── labels: sort by price, then place above/below ──
        int nL = array.size(lblY)
        if nL > 0
            // Parallel bubble sort ascending by y (n ≈ 40; same trick as the
            // reference scripts' confluence sort).
            for i = 0 to nL - 2
                for j = 0 to nL - i - 2
                    if array.get(lblY, j) > array.get(lblY, j + 1)
                        float ty = array.get(lblY, j)
                        array.set(lblY, j, array.get(lblY, j + 1))
                        array.set(lblY, j + 1, ty)
                        string tt = array.get(lblTxt, j)
                        array.set(lblTxt, j, array.get(lblTxt, j + 1))
                        array.set(lblTxt, j + 1, tt)
                        color tc = array.get(lblCol, j)
                        array.set(lblCol, j, array.get(lblCol, j + 1))
                        array.set(lblCol, j + 1, tc)

            float gapPx = close * labelGapPct / 100.0
            bool above = true
            float prevY = na
            for i = 0 to nL - 1
                float y = array.get(lblY, i)
                string txt = array.get(lblTxt, i)
                color c = array.get(lblCol, i)
                lstyle = label.style_label_left
                if labelSide == "自动错开"
                    if na(prevY) or (y - prevY) > gapPx
                        above := true   // clear of the previous label: reset to top
                    else
                        above := not above
                    lstyle := above ? label.style_label_up : label.style_label_down
                else if labelSide == "线上方"
                    lstyle := label.style_label_up
                else if labelSide == "线下方"
                    lstyle := label.style_label_down
                prevY := y
                array.push(lbs, label.new(bar_index + labelOff, y, txt, style = lstyle, color = color.new(color.black, 100), textcolor = c, size = f_size(labelSize)))

// ─────────────────────────── LEGEND / ABBREVIATION PANEL ─────────────────
// Surfaces (a) the snapshot status and (b) what every abbreviation means, so a
// viewer who did not author the string can still read the chart. Position is
// user-selectable so it does not fight the price axis on any layout.
var table panel = table.new(position.top_right, 2, 24, border_width = 0)

f_panelPos() =>
    panelPos == "Top right" ? position.top_right
     : panelPos == "Top left" ? position.top_left
     : panelPos == "Bottom right" ? position.bottom_right
     : position.bottom_left

if showPanel and barstate.islast
    // Rebuild at the chosen position each time settings change.
    table.clear(panel, 0, 0, 1, 23)
    // table.position is fixed at construction; when the user flips position we
    // recreate the table. Pine has no table.set_position, so detect a change
    // via a var guard.
    var string lastPos = ""
    if lastPos != panelPos
        lastPos := panelPos
        panel := table.new(f_panelPos(), 2, 24, border_width = 0)

    // size.* constants are a distinct type, not int — leave pSz untyped so Pine
    // infers it from the ternary (CE10173 if declared `int`).
    pSz = panelSize == "Tiny" ? size.tiny : panelSize == "Small" ? size.small : size.normal
    int r = 0

    // Header row: symbol + snapshot basis (live / prior-close).
    table.cell(panel, 0, r, "GEX " + (gSym == "" ? "?" : gSym), text_color = #F0B90B, text_size = pSz, text_halign = text.align_left)
    table.cell(panel, 1, r, gBasis == "" ? "" : gBasis, text_color = gBasis == "today-live" ? #26A69A : #787B86, text_size = pSz, text_halign = text.align_left)
    r += 1

    // Snapshot line: spot, net gamma, IV / RV, age.
    table.cell(panel, 0, r, "spot / netGEX", text_color = #787B86, text_size = pSz, text_halign = text.align_left)
    table.cell(panel, 1, r, (gSpot == "" ? "—" : gSpot) + "  " + (gNetGex == "" ? "" : gNetGex), text_color = #E8E6E1, text_size = pSz, text_halign = text.align_left)
    r += 1
    if gIV != "" or gRV != ""
        table.cell(panel, 0, r, "IV / RV %", text_color = #787B86, text_size = pSz, text_halign = text.align_left)
        table.cell(panel, 1, r, (gIV == "" ? "—" : gIV) + " / " + (gRV == "" ? "—" : gRV), text_color = #E8E6E1, text_size = pSz, text_halign = text.align_left)
        r += 1
    if gAsof != ""
        table.cell(panel, 0, r, "as of (UTC)", text_color = #787B86, text_size = pSz, text_halign = text.align_left)
        // Trim the fractional seconds for the panel.
        table.cell(panel, 1, r, str.substring(gAsof, 0, math.min(str.length(gAsof), 19)) + "Z", text_color = #787B86, text_size = pSz, text_halign = text.align_left)
        r += 1
    if gOiPc != ""
        table.cell(panel, 0, r, "OI P/C", text_color = #787B86, text_size = pSz, text_halign = text.align_left)
        table.cell(panel, 1, r, gOiPc, text_color = #E8E6E1, text_size = pSz, text_halign = text.align_left)
        r += 1

    // Separator.
    r += 0
    table.cell(panel, 0, r, "─ levels ─", text_color = #787B86, text_size = pSz, text_halign = text.align_left)
    table.cell(panel, 1, r, "", text_color = #787B86, text_size = pSz)
    r += 1

    // Abbreviation glossary. Each row: short name → explanation.
    array<string> names  = array.from("CW / PW", "flip", "gwall", "vtrig", "hgex", "G+ / G-", "mpain", "oic/oip", "emh/eml", "ivh/ivl")
    array<string> expls  = array.from("call / put wall", "gamma flip", "gamma wall", "vol trigger", "max |GEX| strike", "most ± net-GEX", "max pain (OI)", "largest OI strike", "expected move ±", "1-day IV range")
    for i = 0 to array.size(names) - 1
        table.cell(panel, 0, r, array.get(names, i), text_color = #E8E6E1, text_size = pSz, text_halign = text.align_left)
        table.cell(panel, 1, r, array.get(expls, i), text_color = #787B86, text_size = pSz, text_halign = text.align_left)
        r += 1

    // Bucket legend: which line style is which expiry.
    table.cell(panel, 0, r, "0DTE", text_color = #E8E6E1, text_size = pSz, text_halign = text.align_left)
    table.cell(panel, 1, r, s0 + " w" + str.tostring(w0), text_color = #787B86, text_size = pSz, text_halign = text.align_left)
    r += 1
    table.cell(panel, 0, r, "Weekly", text_color = #E8E6E1, text_size = pSz, text_halign = text.align_left)
    table.cell(panel, 1, r, sW + " w" + str.tostring(wW), text_color = #787B86, text_size = pSz, text_halign = text.align_left)
    r += 1
    table.cell(panel, 0, r, "Monthly", text_color = #E8E6E1, text_size = pSz, text_halign = text.align_left)
    table.cell(panel, 1, r, sM + " w" + str.tostring(wM), text_color = #787B86, text_size = pSz, text_halign = text.align_left)
    r += 1
    table.cell(panel, 0, r, "All-exp", text_color = #E8E6E1, text_size = pSz, text_halign = text.align_left)
    table.cell(panel, 1, r, sA + " w" + str.tostring(wA), text_color = #787B86, text_size = pSz, text_halign = text.align_left)

// ─────────────────────────────── DEBUG ROW ───────────────────────────────
// Instruments the parse pipeline so a silent no-render is diagnosable from a
// screenshot: 数据 0 → the paste never committed to the input; 行>0 画 0 →
// every level was filtered out; 画>0 but nothing on the chart → the chart
// symbol's price scale doesn't cover the levels (wrong symbol family).
var table dbg = table.new(position.top_left, 1, 2)
if showDebug and barstate.islast
    int dLen = str.length(srcText)
    string dbgMsg = IND_VER + " · 数据 " + str.tostring(dLen) + " 字 · 行 " + str.tostring(dbgRows) + " · 画 " + str.tostring(dbgDrawn) + (gSym == "" ? "" : " · " + gSym)
    color dbgBg = dLen == 0 ? color.new(#EF5350, 10) : dbgDrawn == 0 ? color.new(#F0B90B, 10) : color.new(#26A69A, 10)
    table.cell(dbg, 0, 0, dbgMsg, text_color = color.white, text_size = size.small, bgcolor = dbgBg)
    table.cell(dbg, 0, 1, "现价 " + str.tostring(close, format.mintick) + " · spot " + (na(gSpotF) ? "—" : str.tostring(gSpotF, "#.##")) + " · ×" + str.tostring(gConv, "#.###") + " · 价差" + (gShift >= 0 ? "+" : "") + str.tostring(gShift, "#.##"), text_color = color.white, text_size = size.small, bgcolor = color.new(#1E222D, 10))
